{
  "name": "HandwritingWorksheet",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Worksheet name shown in the saved dropdown"
    },
    "text": {
      "type": "string",
      "default": "",
      "description": "Words to practice. One per row (space or newline separated). Use >: or .: before a word to force arrows or dots-only mode."
    },
    "rows_per_page": {
      "type": "integer",
      "default": 6,
      "description": "Handwriting rows per page"
    },
    "orientation": {
      "type": "string",
      "enum": [
        "portrait",
        "landscape"
      ],
      "default": "portrait",
      "description": "Page orientation"
    },
    "color": {
      "type": "string",
      "default": "#2e7d32",
      "description": "Font color (hex)."
    }
  },
  "required": [
    "name"
  ]
}