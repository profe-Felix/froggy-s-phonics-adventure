{
  "name": "HandwritingWorksheet",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Worksheet name shown in the saved dropdown"
    },
    "text": {
      "type": "string",
      "default": "",
      "description": "Words to practice (space-separated, one per row)"
    },
    "rows_per_page": {
      "type": "integer",
      "default": 6,
      "description": "Handwriting rows per page"
    },
    "orientation": {
      "type": "string",
      "enum": [
        "portrait",
        "landscape"
      ],
      "default": "portrait",
      "description": "Page orientation"
    }
  },
  "required": [
    "name"
  ]
}