{
  "name": "LiveLessonSession",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Short join code students enter or scan via QR"
    },
    "lesson_id": {
      "type": "string",
      "description": "ID of the Lesson being run live"
    },
    "lesson_title": {
      "type": "string",
      "default": "",
      "description": "Cached lesson title for display"
    },
    "class_name": {
      "type": "string",
      "default": "",
      "description": "Class this session is for. Drives auto-join banner for students in this class."
    },
    "school_year": {
      "type": "string",
      "description": "School year tag e.g. '26-27'.",
      "default": ""
    },
    "target_students": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class_name": {
            "type": "string"
          },
          "student_number": {
            "type": "integer"
          }
        }
      },
      "default": [],
      "description": "For small group: specific students targeted. Empty array = whole class auto-joins."
    },
    "current_step": {
      "type": "integer",
      "default": 0,
      "description": "Index of the step the teacher is currently on. In 'stay' mode all joined students are locked here. In 'lesson' mode this is the floor students can't fall behind."
    },
    "phase": {
      "type": "string",
      "enum": [
        "watch",
        "try"
      ],
      "default": "watch",
      "description": "watch = teacher models (I do), students see a live mirror of the teacher's screen. try = released to interact with the activity themselves (we do / you do). Only meaningful in 'stay' release mode."
    },
    "release_mode": {
      "type": "string",
      "enum": [
        "stay",
        "lesson"
      ],
      "default": "stay",
      "description": "stay = everyone stays on the teacher's current step (together). lesson = students work through the steps in order at their own pace; the teacher's current_step is a floor they can't fall behind, and the teacher can advance it even if some aren't done."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "False once the teacher ends the session. Students return to their normal home."
    },
    "started_at": {
      "type": "string",
      "description": "ISO timestamp when the session started"
    },
    "joined_students": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class_name": {
            "type": "string"
          },
          "student_number": {
            "type": "integer"
          },
          "joined_at": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Roster of students who have joined this live session, for the teacher's control panel."
    },
    "broadcast_state": {
      "type": "object",
      "description": "Live mirror of the teacher's screen during the 'watch' phase. Teacher's model panel writes here (throttled); student mirror panels read from here. Shape depends on the step type: video = {type:'video', playing, currentTime, updatedAt}, counting = {type:'counting', placed, drag, itemIndex, itemText, items, mode, correct}.",
      "default": {}
    }
  },
  "required": [
    "code",
    "lesson_id"
  ],
  "rls": {
    "create": null,
    "read": {},
    "update": null,
    "delete": null
  }
}