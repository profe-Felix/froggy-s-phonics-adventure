{
  "name": "LiveNotebookAssessment",
  "type": "object",
  "properties": {
    "class_name": {
      "type": "string",
      "description": "Class this live notebook assessment is broadcasting to. Students in this class are forced into the notebook assignment (unless target_students is non-empty, in which case only those students join)."
    },
    "assignment_id": {
      "type": "string",
      "description": "ID of the DigitalNotebookAssignment being assessed live"
    },
    "assignment_title": {
      "type": "string",
      "default": "",
      "description": "Cached assignment title for display"
    },
    "school_year": {
      "type": "string",
      "default": "",
      "description": "School year tag e.g. '26-27'."
    },
    "target_students": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class_name": {
            "type": "string"
          },
          "student_number": {
            "type": "integer"
          }
        }
      },
      "default": [],
      "description": "Specific students targeted. Empty array = whole class auto-joins. Non-empty = only these students are pulled in (useful for absent students or small-group modeling)."
    },
    "release_mode": {
      "type": "string",
      "enum": [
        "follow",
        "free"
      ],
      "default": "follow",
      "description": "follow = students are locked to the teacher's current_page and cannot navigate on their own. free = students can navigate pages at their own pace; the teacher's page advances are not forced on them."
    },
    "current_page": {
      "type": "integer",
      "default": 1,
      "description": "Page all students are locked to (in 'follow' mode). Teacher advances this; students follow in realtime. In 'free' mode this is just the teacher's own view."
    },
    "total_pages": {
      "type": "integer",
      "default": 1,
      "description": "Cached total page count of the assignment, for the teacher's page nav bounds."
    },
    "paused": {
      "type": "boolean",
      "default": false,
      "description": "When true, every student's notebook shows an 'Eyes on board' overlay and drawing/navigation is frozen. Used when someone comes to the door to prevent cheating."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "False once the teacher ends the session. Students are freed back to their normal login."
    },
    "started_at": {
      "type": "string",
      "description": "ISO timestamp when the live session started"
    }
  },
  "required": [
    "class_name",
    "assignment_id"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}