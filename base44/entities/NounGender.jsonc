{
  "name": "NounGender",
  "type": "object",
  "properties": {
    "word": {
      "type": "string",
      "description": "Spanish word in its actual written form."
    },
    "image_url": {
      "type": "string",
      "format": "uri",
      "description": "Picture URL from the letter-sort image bucket.",
      "default": ""
    },
    "part_of_speech": {
      "type": "string",
      "enum": [
        "",
        "noun",
        "verb",
        "adjective",
        "determiner",
        "pronoun",
        "preposition",
        "adverb",
        "conjunction",
        "other"
      ],
      "default": "",
      "description": "Teacher-assigned Spanish part of speech. Never inferred from spelling."
    },
    "gender": {
      "type": "string",
      "enum": [
        "",
        "masculine",
        "feminine",
        "common"
      ],
      "default": "",
      "description": "Teacher-assigned grammatical gender or agreement compatibility when applicable."
    },
    "number": {
      "type": "string",
      "enum": [
        "",
        "singular",
        "plural"
      ],
      "default": "",
      "description": "Teacher-assigned grammatical number or agreement compatibility when applicable."
    },
    "article": {
      "type": "string",
      "enum": [
        "",
        "el",
        "la",
        "los",
        "las"
      ],
      "default": "",
      "description": "Definite article associated with a noun when applicable."
    },
    "determiner_type": {
      "type": "string",
      "enum": [
        "",
        "definite_article",
        "indefinite_article",
        "possessive",
        "possessive_agreeing",
        "other"
      ],
      "default": "",
      "description": "Teacher-assigned determiner subtype when part_of_speech is determiner."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "If false, this word is excluded from generated literacy activities."
    }
  },
  "required": [
    "word"
  ],
  "rls": {
    "read": null,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}