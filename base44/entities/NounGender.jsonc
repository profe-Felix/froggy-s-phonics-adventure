{
  "name": "NounGender",
  "type": "object",
  "properties": {
    "word": {
      "type": "string",
      "description": "The noun word (lowercase pretty form, e.g. 'mesa', 'arbol')."
    },
    "image_url": {
      "type": "string",
      "format": "uri",
      "description": "Picture URL from the letter-sort image bucket. Seeded automatically when the editor scans the bucket.",
      "default": ""
    },
    "gender": {
      "type": "string",
      "enum": [
        "",
        "masculine",
        "feminine"
      ],
      "default": "",
      "description": "Grammatical gender. Empty = not yet assigned. Drives article+noun phrase auto-generation (masculine \u2192 el/los, feminine \u2192 la/las)."
    },
    "number": {
      "type": "string",
      "enum": [
        "singular",
        "plural"
      ],
      "default": "singular",
      "description": "Grammatical number. Auto-detected from the word (Spanish plurals end in -s). Drives article selection: singular \u2192 el/la, plural \u2192 los/las."
    },
    "article": {
      "type": "string",
      "enum": [
        "",
        "el",
        "la",
        "los",
        "las"
      ],
      "default": "",
      "description": "Definite article. Auto-derived from gender + number (masculine singular\u2192el, masculine plural\u2192los, feminine singular\u2192la, feminine plural\u2192las) but editable for exceptions like 'el agua', 'la mano'."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "If false, this noun is excluded from phrase generation and picture cards."
    }
  },
  "required": [
    "word"
  ],
  "rls": {
    "read": null,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}