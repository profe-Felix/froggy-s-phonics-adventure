{
  "name": "FluencySession",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Short join code students enter to join the live table"
    },
    "preset_id": {
      "type": "string",
      "description": "Active preset lesson id (matches a key in the Supabase presets file, or a curriculum-generated id like 'curriculum_M2.L6_sight_words')"
    },
    "preset_data": {
      "type": "object",
      "description": "When the session was built from the curriculum builder (week + day), the full generated preset object is stored here so students render the same table without needing it in the Supabase presets file. Shape: { id, title, rows, cols, sweep_ms, content[] }. Null/empty for manual-preset sessions.",
      "default": {}
    },
    "seed": {
      "type": "integer",
      "description": "Shuffle seed shared by all participants so the table is identical"
    },
    "active_row": {
      "type": "integer",
      "default": 0,
      "description": "Row currently being swept"
    },
    "sweep_start_at": {
      "type": "string",
      "default": "",
      "description": "ISO timestamp when the current row sweep started; empty when idle. Clients animate locally from this shared time."
    }
  },
  "required": [
    "code",
    "preset_id",
    "seed"
  ],
  "rls": {
    "create": null,
    "read": {},
    "update": null,
    "delete": null
  }
}