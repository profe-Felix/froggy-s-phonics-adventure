{
  "name": "AudioFeedback",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "sentences",
        "spelling",
        "sight_words_easy",
        "sight_words_spelling"
      ],
      "description": "Which game mode"
    },
    "item_text": {
      "type": "string",
      "description": "The word or sentence"
    },
    "feedback_type": {
      "type": "string",
      "enum": [
        "unclear_audio",
        "missing_audio"
      ],
      "description": "Type of feedback"
    },
    "student_number": {
      "type": "integer",
      "description": "Student who reported it (if available)"
    },
    "class_name": {
      "type": "string",
      "description": "Class name (if available)"
    },
    "school_year": {
      "type": "string",
      "description": "School year tag e.g. '26-27'. Prevents cross-year collisions when the same class+number is reused.",
      "default": ""
    },
    "reported_date": {
      "type": "string",
      "description": "ISO timestamp"
    }
  },
  "required": [
    "mode",
    "item_text",
    "feedback_type"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    }
  }
}