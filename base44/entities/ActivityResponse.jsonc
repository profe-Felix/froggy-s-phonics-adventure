{
  "name": "ActivityResponse",
  "type": "object",
  "properties": {
    "activity_mode": {
      "type": "string",
      "enum": [
        "counting_words",
        "counting_phonemes",
        "phoneme_manipulation",
        "text_hunt"
      ],
      "description": "Which activity the response belongs to: counting words, counting phonemes, phoneme manipulation (clone colored counters), or text hunt (find targets in connected text)"
    },
    "student_name": {
      "type": "string",
      "default": "Estudiante",
      "description": "Free-text name the student entered (the Activities test tool has no student-login integration)"
    },
    "class_name": {
      "type": "string",
      "default": ""
    },
    "item_text": {
      "type": "string",
      "description": "The sentence or word the student worked on"
    },
    "item_index": {
      "type": "integer",
      "default": 0
    },
    "tile_count": {
      "type": "integer",
      "default": 0,
      "description": "Total number of boxes/tiles/targets available for the item"
    },
    "placed_count": {
      "type": "integer",
      "description": "Number of targets the student found (their answer)",
      "default": 0
    },
    "correct_count": {
      "type": "integer",
      "description": "Auto-computed correct count for the item",
      "default": 0
    },
    "is_correct": {
      "type": "boolean",
      "default": false
    },
    "placements_data": {
      "type": "string",
      "description": "JSON timeline of placement events. Counting modes: array of {t, type:'place'|'remove', tile, boxIndex}. Manipulation mode: object {palette, gestures, boxCount, finalPlaced}. Text hunt: object {huntType, target, segments, taps:[{index,t,correct}], missed, correctCount, foundCount}."
    },
    "audio_url": {
      "type": "string",
      "description": "Uploaded voice recording URL"
    },
    "duration_ms": {
      "type": "integer",
      "default": 0
    },
    "submitted_at": {
      "type": "string",
      "description": "ISO timestamp"
    },
    "reviewed": {
      "type": "boolean",
      "default": false
    },
    "teacher_note": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "activity_mode",
    "item_text"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    }
  }
}