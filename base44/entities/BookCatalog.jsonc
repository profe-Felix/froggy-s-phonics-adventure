{
  "name": "BookCatalog",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "es",
        "en",
        "bilingual"
      ],
      "default": "es",
      "description": "Primary language of this permanent catalog book"
    },
    "grade": {
      "type": "string",
      "enum": [
        "kinder",
        "first"
      ],
      "default": "kinder",
      "description": "Grade level of this permanent catalog book"
    },
    "subject": {
      "type": "string",
      "enum": [
        "df",
        "lv",
        "library"
      ],
      "default": "lv",
      "description": "Curriculum subject: df = Destrezas Fundamentales (Phonics), lv = Lectura y Vocabulario (Reading), library = classroom library (random, not tied to specific lessons). DF and LV follow different pacing and lesson/module sequences."
    },
    "pdf_url": {
      "type": "string",
      "description": "Permanent PDF source for this book"
    },
    "cover_image_url": {
      "type": "string",
      "description": "Permanent cover image for this book"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Array of page objects. For image books: {page_number, image_url}. For HTML books: {page_number, image_url, html_url, words: [{text, x, y, w, h}]}."
    },
    "pdf_page_count": {
      "type": "integer",
      "default": 1
    },
    "book_type": {
      "type": "string",
      "enum": [
        "pdf",
        "images",
        "html"
      ],
      "default": "pdf"
    },
    "module": {
      "type": "string",
      "default": "",
      "description": "Module folder such as M1, M2, or M3"
    },
    "lesson": {
      "type": "string",
      "default": "",
      "description": "Lesson tag e.g. 'L1'. Combined with module forms M#.L# (e.g. M2.L1) so the book can be tied to a specific daily curriculum lesson later."
    },
    "lessons": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Optional lesson tags within this module, e.g. L2 and L5. Empty means module-only; never restricts the comprehension book picker."
    },
    "recording_pages": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "default": [],
      "description": "Permanent list of pages on which students should make recordings"
    },
    "source_assignment_id": {
      "type": "string",
      "default": "",
      "description": "Original BookAssignment used when this catalog record was created"
    },
    "word_bank_imported": {
      "type": "boolean",
      "default": false,
      "description": "True if this book's text has been scanned and its words imported into the WordBank via the Import from books tool. Set automatically when a scan completes."
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}