{
  "name": "SeatingLayout",
  "type": "object",
  "properties": {
    "class_name": {
      "type": "string",
      "description": "Class this seating layout belongs to."
    },
    "school_year": {
      "type": "string",
      "default": "",
      "description": "School year tag e.g. '26-27'."
    },
    "desk_data": {
      "type": "string",
      "default": "[]",
      "description": "JSON array of desks: { id, x, y, rotation, student_id }."
    },
    "carpet_data": {
      "type": "string",
      "default": "[]",
      "description": "JSON array of carpet seats: { index, student_id }."
    }
  },
  "required": [
    "class_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    }
  }
}