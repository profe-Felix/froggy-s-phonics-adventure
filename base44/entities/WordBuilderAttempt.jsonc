{
  "name": "WordBuilderAttempt",
  "type": "object",
  "properties": {
    "student_number": {
      "type": "integer"
    },
    "class_name": {
      "type": "string"
    },
    "school_year": {
      "type": "string",
      "description": "School year tag e.g. '26-27'. Prevents cross-year collisions when the same class+number is reused.",
      "default": ""
    },
    "preset_id": {
      "type": "string",
      "description": "Which lesson/preset was used"
    },
    "preset_label": {
      "type": "string",
      "description": "Human-readable preset name"
    },
    "num_problems": {
      "type": "integer"
    },
    "problems_data": {
      "type": "string",
      "description": "JSON: array of {expected, tiles, isCorrect} for each problem row"
    },
    "events_data": {
      "type": "string",
      "description": "JSON: time-ordered array of {t, type, problemIdx, tileValue, tiles} for replay"
    },
    "all_correct": {
      "type": "boolean"
    },
    "submitted_at": {
      "type": "string",
      "description": "ISO timestamp"
    }
  },
  "required": [
    "student_number",
    "class_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "student"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}