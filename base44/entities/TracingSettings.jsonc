{
  "name": "TracingSettings",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "default": "default",
      "description": "Settings key. 'default' = the global fallback used by every class that has no override. A class name (e.g. 'Schwarz') = a per-class override that takes precedence over the default for that class."
    },
    "class_name": {
      "type": "string",
      "default": "",
      "description": "Class this setting belongs to. Empty = the global default. Set to a class name (e.g. 'Schwarz') for a per-class letter progression override."
    },
    "enabled_letters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "o",
        "O",
        "i",
        "I",
        "a",
        "A",
        "u",
        "U",
        "e",
        "E"
      ],
      "description": "Case-sensitive letters currently enabled for Letter Tracing free play. Teachers toggle these on/off from the Letter Tracing Authoring page as letters are learned. Lesson steps pass their own targets and bypass this."
    }
  },
  "required": [
    "scope"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    }
  }
}