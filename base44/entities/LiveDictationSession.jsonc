{
  "name": "LiveDictationSession",
  "type": "object",
  "properties": {
    "class_name": {
      "type": "string",
      "description": "Class this live dictation session is broadcasting to. Students in this class are forced into the assignment."
    },
    "assignment_id": {
      "type": "string",
      "description": "ID of the DictationAssignment being broadcast live"
    },
    "assignment_title": {
      "type": "string",
      "default": "",
      "description": "Cached assignment title for display"
    },
    "school_year": {
      "type": "string",
      "default": "",
      "description": "School year tag e.g. '26-27'."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "False once the teacher ends the session. Students are freed back to their normal login."
    },
    "started_at": {
      "type": "string",
      "description": "ISO timestamp when the live session started"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "The dictado words/sentences, one per line. Set when launched from a lesson step (inline authoring). Empty for legacy dashboard-launched sessions."
    },
    "broadcast_state": {
      "type": "object",
      "default": {},
      "description": "Live teacher\u2192student sync: { current_line: int, revealed: bool }. current_line = which line students write on; revealed = teacher has shown the answer, which locks the attempt ink and switches students to red correction ink."
    }
  },
  "required": [
    "class_name",
    "assignment_id"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}