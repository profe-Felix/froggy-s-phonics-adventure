{
  "name": "DigitalNotebookAssignment",
  "type": "object",
  "properties": {
    "library_key": {
      "type": "string",
      "description": "SHA-256 PDF identity for shared library grouping; never a student-work or authorization identifier."
    },
    "title": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL of the uploaded PDF"
    },
    "pdf_page_count": {
      "type": "integer",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "closed"
      ],
      "default": "draft"
    },
    "page_mode": {
      "type": "string",
      "enum": [
        "locked",
        "free"
      ],
      "default": "free",
      "description": "locked = teacher controls page, free = student picks"
    },
    "locked_page": {
      "type": "integer",
      "default": 1,
      "description": "Current page when mode=locked"
    },
    "limit_pages": {
      "type": "boolean",
      "default": false,
      "description": "If true, restrict students to page_range_start..page_range_end"
    },
    "page_range_start": {
      "type": "integer",
      "description": "First allowed page (free mode, when limit_pages=true)"
    },
    "page_range_end": {
      "type": "integer",
      "description": "Last allowed page (free mode, when limit_pages=true)"
    },
    "letter_help": {
      "type": "array",
      "default": [],
      "description": "Shared page/range letter-formation help; normalized page pins, targets and default replay speed. Never student ink.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "pageStart": { "type": "integer", "minimum": 1 },
          "pageEnd": { "type": "integer", "minimum": 1 },
          "letters": { "type": "array", "items": { "type": "string" } },
          "x": { "type": "number", "minimum": 0.02, "maximum": 0.98 },
          "y": { "type": "number", "minimum": 0.02, "maximum": 0.98 },
          "speed": { "type": "number", "enum": [0.25, 0.5, 1] },
          "enabled": { "type": "boolean" }
        },
        "required": ["id", "pageStart", "pageEnd", "letters", "x", "y", "speed", "enabled"]
      }
    },
    "audio_instructions": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array of {page, url, label}"
    },
    "video_instructions": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array of {page, url, label, type}"
    },
    "recording_pages": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "Pages where students can record voice/video notes",
      "default": []
    },
    "shared_across_classes": {
      "type": "boolean",
      "default": false,
      "description": "If true, this assignment is visible in the shared library for all classes"
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "If true, this assignment is hidden from the student assignment picker list. Students can still access it via a direct QR link (URL with ?assignment=Title)."
    }
  },
  "required": [
    "title",
    "class_name"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}