{
  "name": "ClassConfig",
  "type": "object",
  "properties": {
    "class_name": {
      "type": "string",
      "description": "Class name this config belongs to (e.g. Felix, Valero, Campos)"
    },
    "color": {
      "type": "string",
      "enum": [
        "red",
        "orange",
        "amber",
        "yellow",
        "green",
        "emerald",
        "teal",
        "cyan",
        "sky",
        "blue",
        "indigo",
        "violet",
        "purple",
        "fuchsia",
        "pink",
        "rose"
      ],
      "default": "emerald",
      "description": "Tailwind color family used for this class's login tiles and accents."
    },
    "grade": {
      "type": "string",
      "enum": [
        "kinder",
        "first"
      ],
      "default": "kinder",
      "description": "Grade level this class belongs to. Drives grouping on the student login screen."
    },
    "language": {
      "type": "string",
      "enum": [
        "es",
        "en"
      ],
      "default": "es",
      "description": "Default content language for students in this class. New students inherit it at creation; literacy audio and word pools pull from this language on Supabase."
    },
    "tracing_only": {
      "type": "boolean",
      "default": false,
      "description": "If true, this class skips the level path and lands on the Games tab with only Letter Tracing available (no sound). Used for classes with a different letter-learning progression, e.g. Schwarz."
    },
    "shares_books_from": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Class names whose active books this class also sees in its bookshelf. e.g. ['Felix'] means this class sees all of Felix's active books in addition to its own. Used to share a book set across linked classes (e.g. Spanish classes) without duplicating book records."
    }
  },
  "required": [
    "class_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "teacher"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    }
  }
}