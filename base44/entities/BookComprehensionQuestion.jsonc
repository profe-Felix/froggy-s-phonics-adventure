{
  "name": "BookComprehensionQuestion",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string",
      "description": "Stable BookCatalog ID for a book-scoped question. page_number is local to this book."
    },
    "question_scope": {
      "type": "string",
      "enum": ["book", "general", "extra"],
      "description": "Absent on legacy questions, which retain concatenated slide numbering."
    },
    "extra_page": {
      "type": "integer",
      "description": "Comparison/extra slide number, independent of either book's page count."
    },
    "lesson_key": {
      "type": "string",
      "description": "Lesson key e.g. 'M2.L1'. Questions are organized per lesson so they can be reused across years."
    },
    "question_text": {
      "type": "string",
      "description": "The comprehension question to ask students."
    },
    "sentence_stem": {
      "type": "string",
      "default": "",
      "description": "The sentence stem students use to answer, shown after the question e.g. 'Los personajes del cuento son _______."
    },
    "page_number": {
      "type": "integer",
      "default": 0,
      "description": "Book page number this question is tied to. 0 = general (not page-specific). In the book reader, pages with questions show a ? button so the teacher can reveal them on demand."
    },
    "anchor_chart_url": {
      "type": "string",
      "default": "",
      "description": "Optional anchor chart image URL displayed alongside the question in PresentMode (e.g. a main-character or setting reference chart). When set, the chart replaces the book pages in the center while the question bar is shown."
    },
    "mark": {
      "type": "object",
      "description": "Optional mark drawn on the page when the question is shown. { shape: 'highlight'|'box'|'underline', book_id, x, y, w, h } with x/y/w/h normalized 0-1 relative to the page.",
      "properties": {
        "shape": {
          "type": "string",
          "enum": [
            "highlight",
            "box",
            "underline"
          ]
        },
        "book_id": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "description": "Display order within the lesson."
    }
  },
  "required": [
    "lesson_key",
    "question_text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}