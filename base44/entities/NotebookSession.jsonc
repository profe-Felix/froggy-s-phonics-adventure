{
  "name": "NotebookSession",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "student_number": {
      "type": "integer"
    },
    "school_year": {
      "type": "string",
      "description": "School year tag e.g. '26-27'. Prevents cross-year collisions when the same class+number is reused.",
      "default": ""
    },
    "current_page": {
      "type": "integer",
      "default": 1
    },
    "strokes_by_page": {
      "type": "object",
      "description": "Map of page number (string key) -> strokes JSON array"
    },
    "voice_notes_by_page": {
      "type": "object",
      "description": "Map of page number (string key) -> audio URL"
    },
    "recordings_by_page": {
      "type": "object",
      "description": "Map of page number (string key) -> video URL"
    },
    "last_active": {
      "type": "string",
      "description": "ISO timestamp"
    }
  },
  "required": [
    "assignment_id",
    "class_name",
    "student_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "student"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        },
        {
          "user_condition": {
            "role": "student"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        },
        {
          "user_condition": {
            "role": "student"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    }
  }
}