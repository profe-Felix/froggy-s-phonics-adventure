{
  "name": "NumberAttempt",
  "type": "object",
  "properties": {
    "student_number": {
      "type": "integer"
    },
    "class_name": {
      "type": "string"
    },
    "school_year": {
      "type": "string",
      "description": "School year tag e.g. '26-27'. Prevents cross-year collisions when the same class+number is reused.",
      "default": ""
    },
    "number": {
      "type": "integer"
    },
    "correct": {
      "type": "boolean"
    }
  },
  "required": [
    "student_number",
    "class_name",
    "number",
    "correct"
  ]
}