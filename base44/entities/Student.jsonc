{
  "name": "Student",
  "type": "object",
  "properties": {
    "student_number": {
      "type": "integer",
      "description": "Student number (1-30)"
    },
    "name": {
      "type": "string",
      "description": "Optional student name"
    },
    "photo_url": {
      "type": "string",
      "format": "uri",
      "description": "Student photo URL (e.g. copied from PrintPro ID cards, or uploaded). Shown on the login tile instead of the number when set, so non-readers can find themselves by picture.",
      "default": ""
    },
    "class_name": {
      "type": "string",
      "description": "Class identifier, e.g. F, V, C"
    },
    "school_year": {
      "type": "string",
      "description": "School year tag e.g. '26-27'. Prevents cross-year collisions when the same class+number is reused.",
      "default": ""
    },
    "language": {
      "type": "string",
      "enum": [
        "es",
        "en"
      ],
      "description": "Interface/content language for this student. Teachers set this; students see it on the game landing page.",
      "default": "es"
    },
    "language_locked": {
      "type": "boolean",
      "description": "If true, only teachers can change the student's language on the landing page.",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Assessment grouping tags e.g. 'Math SG 1', 'Decoding SG 2'",
      "default": []
    },
    "coins": {
      "type": "integer",
      "description": "Unified coin balance \u2014 earned from lessons, mastered skills, games, and reading; spent to spin the character wheel.",
      "default": 0
    },
    "banked_spins": {
      "type": "integer",
      "description": "Free spins earned (e.g. from tracing) but not yet claimed. Students can claim them from the home screen wheel.",
      "default": 0
    },
    "unlocked_characters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Character IDs (e.g. '0001') the student has unlocked from the character wheel.",
      "default": []
    },
    "active_character": {
      "type": "string",
      "description": "Character ID currently shown on the map."
    },
    "active_pet": {
      "type": "string",
      "description": "ID of currently active pet (legacy)"
    },
    "unlocked_pets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of unlocked pet IDs (legacy)",
      "default": []
    },
    "pending_pet_unlocks": {
      "type": "integer",
      "description": "Number of mystery box reveals waiting (legacy)",
      "default": 0
    },
    "unlocked_fruits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of fruit emojis collected (one per 75 spelling pts) (legacy)",
      "default": []
    },
    "spelling_total_points": {
      "type": "integer",
      "description": "Lifetime spelling points across spelling + sight words spelling modes (legacy)",
      "default": 0
    },
    "sentences_total_points": {
      "type": "integer",
      "description": "Lifetime sentence points (legacy)",
      "default": 0
    },
    "sentence_prize_spins_claimed": {
      "type": "integer",
      "description": "Number of sentence prize wheel spins already claimed (legacy)",
      "default": 0
    },
    "redeemed_prizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Prize IDs claimed forever (one-time prizes like ring) (legacy)",
      "default": []
    },
    "prize_history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Every prize wheel result claimed by the student (legacy)",
      "default": []
    },
    "active_prizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Prize IDs currently active (e.g. cushion, friend, lollipop). Teacher manages these. (legacy)",
      "default": []
    },
    "cushion_since": {
      "type": "number",
      "description": "Unix timestamp when cushion prize was granted, for FIFO eviction (legacy)"
    },
    "mode_progress": {
      "type": "object",
      "properties": {
        "letter_sounds": {
          "type": "object",
          "properties": {
            "mastered_items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "learning_items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "item_attempts": {
              "type": "object"
            },
            "total_correct": {
              "type": "integer"
            },
            "total_attempts": {
              "type": "integer"
            },
            "unlocked": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "sight_words_easy": {
          "type": "object",
          "properties": {
            "mastered_items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "learning_items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "item_attempts": {
              "type": "object"
            },
            "total_correct": {
              "type": "integer"
            },
            "total_attempts": {
              "type": "integer"
            },
            "unlocked": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "sight_words_spelling": {
          "type": "object",
          "properties": {
            "mastered_items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "learning_items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "item_attempts": {
              "type": "object"
            },
            "total_correct": {
              "type": "integer"
            },
            "total_attempts": {
              "type": "integer"
            },
            "unlocked": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "spelling": {
          "type": "object",
          "properties": {
            "mastered_items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "learning_items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "item_attempts": {
              "type": "object"
            },
            "total_correct": {
              "type": "integer"
            },
            "total_attempts": {
              "type": "integer"
            },
            "unlocked": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "case_matching": {
          "type": "object",
          "properties": {
            "mastered_items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "learning_items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "item_attempts": {
              "type": "object"
            },
            "total_correct": {
              "type": "integer"
            },
            "total_attempts": {
              "type": "integer"
            },
            "unlocked": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "letter_tracing": {
          "type": "object",
          "properties": {
            "mastered_items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "learning_items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "item_attempts": {
              "type": "object"
            },
            "total_correct": {
              "type": "integer"
            },
            "total_attempts": {
              "type": "integer"
            },
            "unlocked": {
              "type": "boolean",
              "default": true
            },
            "stage_state": {
              "type": "object",
              "description": "Per-letter staged tracing progress (stageIndex, stageSuccesses, cleanStreak, repairReps, mistakes, totalSuccesses, totalAttempts, mastered). Restored on refresh so tracing progress survives."
            },
            "global_size_index": {
              "type": "integer",
              "description": "Current cohort size index (0=Huge through 5=Paper). Saved so tracing progress survives refresh.",
              "default": 0
            },
            "global_stage_index": {
              "type": "integer",
              "description": "Alias for global_size_index (legacy compatibility).",
              "default": 0
            }
          }
        }
      }
    },
    "current_mode": {
      "type": "string",
      "enum": [
        "letter_sounds",
        "sight_words_easy",
        "sight_words_spelling",
        "spelling",
        "case_matching",
        "letter_tracing",
        "word_tracing"
      ],
      "default": "letter_sounds"
    }
  },
  "required": [
    "student_number"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    }
  }
}