{
  "name": "BookVocabularyOcrCache",
  "type": "object",
  "description": "Server-prepared OCR text for an existing catalog PDF; no student data or teacher review decisions.",
  "properties": {
    "book_id": { "type": "string" },
    "pdf_url": { "type": "string" },
    "words": { "type": "array", "items": { "type": "string" } },
    "prepared_at": { "type": "string" }
  },
  "required": ["book_id", "pdf_url", "words"],
  "rls": {
    "read": null,
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
