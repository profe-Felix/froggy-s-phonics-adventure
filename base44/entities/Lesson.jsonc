{
  "name": "Lesson",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Lesson name shown to students and teachers"
    },
    "lesson_number": {
      "type": "integer",
      "default": 1,
      "description": "Order number for display (Lesson 1, 2, ...). Set to 0 for guided practice lessons that are not on the level path."
    },
    "class_name": {
      "type": "string",
      "default": "",
      "description": "Class this lesson is assigned to. Empty string = available to all classes."
    },
    "language": {
      "type": "string",
      "enum": [
        "",
        "es",
        "en"
      ],
      "default": "",
      "description": "Content language for this lesson. Empty = all languages (shown to every student). 'es' = Spanish only. 'en' = English only. Lets teachers build language-specific lessons for classes like Schwarz."
    },
    "school_year": {
      "type": "string",
      "description": "School year tag e.g. '26-27'. Empty = current/any.",
      "default": ""
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "description": "One-line description shown under the lesson title e.g. 'Learn the letter M and practice saying words and sounds!'"
    },
    "assignment_type": {
      "type": "string",
      "enum": [
        "class",
        "guided",
        "side_quest"
      ],
      "default": "class",
      "description": "class = shown on the main level path for the whole class. guided = guided practice; not on the level path, available to all students from their Quests tab, and launchable as a live lesson. side_quest = assigned to specific students, appears in their Side Quests menu for small-group practice."
    },
    "assigned_students": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class_name": {
            "type": "string"
          },
          "student_number": {
            "type": "integer"
          }
        }
      },
      "default": [],
      "description": "For side quests: the specific students assigned. Each entry is { class_name, student_number }."
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "letter_sounds",
              "sight_words_easy",
              "sight_words_spelling",
              "spelling",
              "case_matching",
              "letter_tracing",
              "phonics",
              "sentences",
              "spanish_reading",
              "storybuilder",
              "book_reading",
              "number_hearing",
              "letter_sort",
              "letter_recognition",
              "powerful_word",
              "syllable_train",
              "syllable_blender",
              "activities",
              "word_builder",
              "fluency",
              "video",
              "soundwall",
              "google_slides",
              "word_tracing"
            ],
            "description": "Which existing activity this step launches"
          },
          "title": {
            "type": "string",
            "description": "Step label shown on the card"
          },
          "emoji": {
            "type": "string",
            "default": "",
            "description": "Emoji shown on the card"
          },
          "color": {
            "type": "string",
            "enum": [
              "sky",
              "pink",
              "yellow",
              "green",
              "orange",
              "purple",
              "blue",
              "teal",
              "rose",
              "indigo"
            ],
            "default": "sky"
          },
          "live_scope": {
            "type": "string",
            "enum": [
              "both",
              "live_only"
            ],
            "default": "both",
            "description": "both = step appears in independent student lessons AND live lessons. live_only = step only appears during teacher-led live lessons (skipped in independent flow)."
          },
          "completion": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "view",
                  "mastery"
                ],
                "default": "view",
                "description": "view = done after one round of participation. mastery = need N items mastered."
              },
              "target": {
                "type": "integer",
                "default": 1,
                "description": "For mastery: number of mastered items required. For view: unused."
              }
            }
          },
          "config": {
            "type": "object",
            "description": "Mode-specific settings (e.g. target letters, preset id, videoUrl, cardUrl, slidesUrl) for per-step overrides.",
            "default": {}
          }
        },
        "required": [
          "mode",
          "title"
        ]
      },
      "default": [],
      "description": "Ordered list of activity steps. Students must complete step N before step N+1 unlocks."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive lessons are hidden from students."
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    }
  }
}