{
  "name": "SoundWallCard",
  "type": "object",
  "properties": {
    "card_type": {
      "type": "string",
      "enum": [
        "phoneme",
        "grapheme"
      ],
      "description": "phoneme = articulation/mouth photo card, grapheme = letter/spelling card"
    },
    "grapheme": {
      "type": "string",
      "description": "The grapheme this card teaches, e.g. 'm', 'p', 'ch', 'qu'. Lowercase instructional form."
    },
    "label": {
      "type": "string",
      "default": "",
      "description": "Display label for the card, e.g. '/m/' or 'm'"
    },
    "image_url": {
      "type": "string",
      "description": "Public URL of the uploaded card image (PNG/JPG). PDFs are converted to PNG on upload."
    },
    "curriculum_key": {
      "type": "string",
      "description": "Curriculum position key, e.g. 'M1.L3'. Used to filter cards by lesson."
    },
    "module_number": {
      "type": "integer",
      "description": "Module number parsed from curriculum_key"
    },
    "lesson_number": {
      "type": "integer",
      "description": "Lesson number parsed from curriculum_key"
    },
    "sort_order": {
      "type": "integer",
      "default": 0,
      "description": "Display order within a lesson"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique cover id"
          },
          "x_pct": {
            "type": "number",
            "description": "Left position as % of card width (0-100)"
          },
          "y_pct": {
            "type": "number",
            "description": "Top position as % of card height (0-100)"
          },
          "w_pct": {
            "type": "number",
            "description": "Width as % of card width (0-100)"
          },
          "h_pct": {
            "type": "number",
            "description": "Height as % of card height (0-100)"
          },
          "label": {
            "type": "string",
            "default": "",
            "description": "Optional label for this cover"
          }
        },
        "required": [
          "id",
          "x_pct",
          "y_pct",
          "w_pct",
          "h_pct"
        ]
      },
      "default": [],
      "description": "Rounded-rectangle covers drawn over the card image. Each cover hides a part of the card; the active_reveal_id cover animates away during the lesson to unveil what's underneath."
    },
    "active_reveal_id": {
      "type": "string",
      "default": "",
      "description": "ID of the cover to animate away (reveal) during the letter-introduction lesson step. Empty = no auto-reveal."
    }
  },
  "required": [
    "card_type",
    "grapheme",
    "image_url",
    "curriculum_key"
  ],
  "rls": {
    "read": null,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}