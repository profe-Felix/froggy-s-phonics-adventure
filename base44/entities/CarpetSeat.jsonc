{
  "name": "CarpetSeat",
  "type": "object",
  "properties": {
    "class_name": {
      "type": "string",
      "description": "Class (teacher) this carpet seat belongs to."
    },
    "group": {
      "type": "string",
      "description": "Rotation group A, B, or C."
    },
    "position": {
      "type": "integer",
      "description": "Seat position index (0-24)"
    },
    "student_id": {
      "type": "string",
      "description": "Seated student ID"
    },
    "partner_label": {
      "type": "string",
      "description": "Talking partner label/icon"
    },
    "status": {
      "type": "string",
      "enum": [
        "present",
        "absent",
        "stepped_out"
      ],
      "default": "present",
      "description": "Attendance status for the seated student. present = in class, absent = not here today, stepped_out = pulled out temporarily. Drives greyed-out rendering and partner reassignment."
    },
    "absent_since": {
      "type": "string",
      "default": "",
      "description": "ISO timestamp when the student was marked absent/stepped_out. Cleared when they return."
    }
  },
  "required": [
    "class_name",
    "group",
    "position"
  ],
  "rls": {
    "read": null,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}