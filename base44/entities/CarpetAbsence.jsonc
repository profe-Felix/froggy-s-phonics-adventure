{
  "name": "CarpetAbsence",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID of the student who was absent or pulled out."
    },
    "student_name": {
      "type": "string",
      "default": "",
      "description": "Denormalized student name for display without joining."
    },
    "class_name": {
      "type": "string",
      "description": "Class (teacher) this absence belongs to."
    },
    "group": {
      "type": "string",
      "description": "Rotation group A, B, or C."
    },
    "type": {
      "type": "string",
      "enum": [
        "absent",
        "stepped_out"
      ],
      "description": "absent = not in school today, stepped_out = pulled out temporarily (intervention, bathroom, office, etc.)."
    },
    "started_at": {
      "type": "string",
      "description": "ISO timestamp when the student was marked out."
    },
    "ended_at": {
      "type": "string",
      "default": "",
      "description": "ISO timestamp when the student returned. Empty while still out."
    },
    "duration_minutes": {
      "type": "integer",
      "default": 0,
      "description": "Total minutes out, computed when the student returns."
    }
  },
  "required": [
    "student_id",
    "class_name",
    "group",
    "type",
    "started_at"
  ],
  "rls": {
    "read": null,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    }
  }
}